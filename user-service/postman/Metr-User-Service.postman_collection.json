    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signup started', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.sessionId).to.be.a('string');",
                  "  pm.expect(json.expiresAt).to.be.a('string');",
                  "  pm.expect(json.attemptsRemaining).to.eql(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"username\": \"{{username}}\",\n  \"acceptedTerms\": true\n}"
            },
            "url": "{{baseUrl}}/auth/signup",
            "description": "Start sign-up and send OTP.\n\n- `username` is required (3–20, letters/numbers/_/-).\n- `acceptedTerms` must be `true`.\n- `phone` must not already be registered.\n\nSaves `sessionId` on the collection. Copy the OTP from the server console into `otpCode`."
          },
          "response": [
            {
              "name": "OTP sent",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"+96651234567\",\n  \"username\": \"Murabaa-1837\",\n  \"acceptedTerms\": true\n}"
                },
                "url": "{{baseUrl}}/auth/signup"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"sessionId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"expiresAt\": \"2026-09-19T14:02:00.000Z\",\n  \"resendAvailableAt\": \"2026-09-19T14:00:30.000Z\",\n  \"attemptsRemaining\": 3\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login OTP started', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "  pm.expect(pm.response.json().sessionId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Start login OTP for an existing account. Unknown phone → `PHONE_NOT_REGISTERED`."
          },
          "response": [
            {
              "name": "OTP sent",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"+96651234567\"\n}"
                },
                "url": "{{baseUrl}}/auth/login"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"sessionId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"expiresAt\": \"2026-09-19T14:02:00.000Z\",\n  \"resendAvailableAt\": \"2026-09-19T14:00:30.000Z\",\n  \"attemptsRemaining\": 3\n}"
            }
          ]
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verified and token issued', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.accessToken).to.be.a('string');",
                  "  pm.expect(json.user).to.have.keys('id', 'username', 'phone');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"code\": \"{{otpCode}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/otp/verify",
            "description": "Verify the 6-digit OTP.\n\nOn success: creates the user (signup) or logs in, returns JWT + user, and saves `accessToken`.\n\nOTP is valid for **2 minutes**, **3 attempts**, then **5 minute** lockout."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sessionId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"code\": \"123456\"\n}"
                },
                "url": "{{baseUrl}}/auth/otp/verify"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\",\n  \"user\": {\n    \"id\": \"8f14e45f-ea8d-4c3b-9c1a-2b7e0d1a9c11\",\n    \"username\": \"Murabaa-1837\",\n    \"phone\": \"+96651234567\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/otp/resend",
            "description": "Send a new OTP.\n\n- Cooldown: **30 seconds** (`OTP_RESEND_COOLDOWN`)\n- Max **3** resends per session (`OTP_RESEND_LIMIT`)\n- Blocked during lockout (`OTP_LOCKED`)"
          }
        },
