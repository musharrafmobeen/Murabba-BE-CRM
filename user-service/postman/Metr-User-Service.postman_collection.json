{
  "info": {
    "_postman_id": "a7c4e2b1-6d8f-4c91-9e3a-metr-user-service",
    "name": "Metr User Service",
    "description": "Complete Postman collection for the Metr user-service HTTP API.\n\n**Base URL:** `{{baseUrl}}` (default `http://localhost:3000`)\n\n**OTP:** If 4Jawaly env vars are empty, the 6-digit code is printed in the NestJS console. Copy it into `{{otpCode}}` (or the Verify OTP body) before verifying.\n\n**Happy path**\n1. Username Available\n2. Sign Up\n3. Copy OTP from server logs into `otpCode`\n4. Verify OTP (saves `accessToken`)\n5. Me / Logout / Delete Account\n\nPhone numbers must be E.164, e.g. `+96651234567`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "phone", "value": "+96651234567" },
    { "key": "username", "value": "Murabaa-1837" },
    { "key": "sessionId", "value": "" },
    { "key": "otpCode", "value": "123456" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.response.code || pm.response.code >= 500) { return; }",
          "let json;",
          "try { json = pm.response.json(); } catch (e) { return; }",
          "if (json && json.sessionId) {",
          "  pm.collectionVariables.set('sessionId', json.sessionId);",
          "}",
          "if (json && json.accessToken) {",
          "  pm.collectionVariables.set('accessToken', json.accessToken);",
          "}"
        ]
      }
    }
  ],
